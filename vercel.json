{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "redirects": [
    {
      "source": "/baixar",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=br.org.movimentoprofetico.app",
      "statusCode": 302
    },
    {
      "source": "/baixar",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/br/app/id6817124101",
      "statusCode": 302
    },
    {
      "source": "/post/:id",
      "destination": "https://movimento-profetico-admin.vercel.app/post/:id",
      "permanent": false
    },
    {
      "source": "/audio/:id",
      "destination": "https://movimento-profetico-admin.vercel.app/audio/:id",
      "permanent": false
    },
    {
      "source": "/live/:id",
      "destination": "https://movimento-profetico-admin.vercel.app/live/:id",
      "permanent": false
    }
  ]
}
